{
  "name": "lingocurrent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "arch": "node scripts/arch-check.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:stories": "vitest run --project=storybook",
    "test:e2e": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "duplication": "jscpd .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@clerk/nextjs": "7.10.0",
    "@opentelemetry/api": "1.9.0",
    "@tanstack/react-query": "5.107.1",
    "@vercel/otel": "2.3.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "postgres": "4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/nextjs-vite": "10.6.7",
    "@tailwindcss/turbopack": "4.3.3",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "24.19.2",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-storybook": "10.6.7",
    "jscpd": "5.4.3",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": "24.x",
    "pnpm": "10.24.0"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/api": "1.9.0"
    }
  },
  "type": "module"
}
